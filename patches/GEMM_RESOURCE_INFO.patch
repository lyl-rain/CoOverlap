diff --git a/csrc/gemm/gemm_runner.h b/csrc/gemm/gemm_runner.h
--- a/csrc/gemm/gemm_runner.h
+++ b/csrc/gemm/gemm_runner.h
@@ -56,6 +56,13 @@
     GemmRunner();
     ~GemmRunner();
 
+    // Read-only preflight introspection. Does not change GEMM execution.
+    uintptr_t workspace_ptr() const noexcept { return reinterpret_cast<uintptr_t>(workspace_); }
+    size_t workspace_bytes() const noexcept { return workspace_size_; }
+    uintptr_t handle_ptr() const noexcept { return reinterpret_cast<uintptr_t>(handle_); }
+    uintptr_t scale_a_ptr() const noexcept { return reinterpret_cast<uintptr_t>(d_scale_a_); }
+    uintptr_t scale_b_ptr() const noexcept { return reinterpret_cast<uintptr_t>(d_scale_b_); }
+
     // BF16 GEMM: D = alpha * A @ B^T + beta * C
     // A: (M, K) row-major bf16
     // B: (N, K) row-major bf16 (transposed as col-major in GEMM)
